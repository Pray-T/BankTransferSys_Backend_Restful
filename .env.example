# Copy to .env and fill in local values. Do not commit .env.
# Spring Boot does not load .env automatically — export these variables
# in your shell / IDE run configuration before bootRun.
# Integration tests do not read DB_NAME or REDIS_DATABASE.
# They use TEST_DB_NAME (default bank_transfer_test) and
# TEST_REDIS_DATABASE (default 1). See application-test.properties.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bank_TransferSys
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password

# Optional integration-test overrides. Leave unset to keep the safe defaults.
# TEST_DB_NAME=bank_transfer_test
# TEST_REDIS_DATABASE=1

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
